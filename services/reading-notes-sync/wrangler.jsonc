{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "reading-notes-sync",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-25",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "ratelimits": [
    {
      "name": "PAIRING_RATE_LIMITER",
      "namespace_id": "48392017",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reading-notes-sync",
      "database_id": "a59eda25-bae5-4818-9a9d-20ac8aebfa3f",
      "migrations_dir": "migrations"
    }
  ]
}
